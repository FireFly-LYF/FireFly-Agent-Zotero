# Project-specific
.worktrees/
.assets
.docs
.web
release-dist/
release-staging/

# Monorepo subprojects (explicit)
plugin/node_modules/
plugin/build/
plugin/logs/
plugin/.scaffold/build/
backend/FireFly/.venv/
backend/FireFly/venv/
backend/FireFly/.pytest_cache/
backend/workspace/**
!backend/workspace/.gitkeep
!backend/workspace/**/.gitkeep
# 勿将嵌套 .git 当作工作区内容提交
backend/workspace/.git/
# Local firefly instance（backend/config/）：忽略密钥与本机状态
backend/config/config.json
backend/config/context.json
backend/config/user.json
backend/config/history/
backend/config/*.local.json
# Agent 生成物与本地下载（勿入库）
backend/docx/
backend/download/*
!backend/download/docx-mcp/
!backend/download/docx-mcp/**
# PDF→Markdown 转换中间/失败产物（raw/markdown 已整体忽略，此处供例外跟踪时兜底）
*.md.part
*.md.converting
*.md.convert-error.txt
*.assets/
# 工作区运行时数据（模板文件 SOUL/USER/MEMORY 仍可由 workspace/.gitignore 白名单跟踪）
backend/workspace/sessions/
backend/workspace/temp/
backend/workspace/memory/history.jsonl
backend/llm-wiki/raw/pdf/**
!backend/llm-wiki/raw/pdf/.gitkeep
backend/llm-wiki/raw/markdown/**
!backend/llm-wiki/raw/markdown/.gitkeep
backend/llm-wiki/raw/rag/**
!backend/llm-wiki/raw/rag/.gitkeep

# llm-wiki：单篇镜像页按用户库变化，与 raw/markdown 同理不强制入库；保留模板与跨篇目录
backend/llm-wiki/wiki/**
!backend/llm-wiki/wiki/README.md
!backend/llm-wiki/wiki/_templates/
!backend/llm-wiki/wiki/_templates/**
!backend/llm-wiki/wiki/_synthesis/
!backend/llm-wiki/wiki/_synthesis/**

